<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pendaftaran Festival Kreativitas Siswa</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans p-4 md:p-8">

  <div class="max-w-4xl mx-auto space-y-8">
    
    <!-- TUGAS 1: HEADER SITUS WEB -->
    <header class="bg-gradient-to-r from-red-600 to-rose-800 text-white p-8 rounded-lg shadow-md text-center">
      <p class="text-sm uppercase tracking-wider font-semibold opacity-90">SMA Semesta / Festival Kreativitas Siswa</p>
      <h1 class="text-3xl md:text-4xl font-bold my-2">Festival Kreativitas Siswa</h1>
      <p class="text-base md:text-lg font-light opacity-95">Pamerkan Kreativitas, Keterampilan, dan Ide Inovatif Anda</p>
    </header>

    <!-- TUGAS 2: FORMULIR PENDAFTARAN -->
    <main class="bg-white p-6 md:p-8 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold text-gray-800 border-b pb-3 mb-6">Formulir Pendaftaran</h2>
      
      <form class="space-y-5" action="#" method="POST">
        
        <!-- 1. Nama Siswa -->
        <div>
          <label for="nama" class="block text-sm font-medium text-gray-700 mb-1">Nama Siswa</label>
          <input type="text" id="nama" name="nama" placeholder="Enter your full name" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500">
        </div>

        <!-- 2. Kelas -->
        <div>
          <label for="kelas" class="block text-sm font-medium text-gray-700 mb-1">Kelas</label>
          <select id="kelas" name="kelas" class="w-full border border-gray-300 rounded-md px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-red-500">
            <option value="" disabled selected>Pilih Kelas</option>
            <option value="X">X</option>
            <option value="XI">XI</option>
            <option value="XII">XII</option>
          </select>
        </div>

        <!-- 3. Jenis Kelamin -->
        <div>
          <span class="block text-sm font-medium text-gray-700 mb-1">Jenis Kelamin</span>
          <div class="flex items-center space-x-6">
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="jenis_kelamin" value="Pria" class="text-red-600 focus:ring-red-500">
              <span class="ml-2 text-gray-700">Pria</span>
            </label>
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="jenis_kelamin" value="Wanita" class="text-red-600 focus:ring-red-500">
              <span class="ml-2 text-gray-700">Wanita</span>
            </label>
          </div>
        </div>

        <!-- 4. Kategori Kompetisi -->
        
        </div>

        <!-- 5. Tipe Partisipasi -->
        <div>
          <span class="block text-sm font-medium text-gray-700 mb-1">Tipe Partisipasi</span>
          <div class="flex items-center space-x-6">
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="tipe_partisipasi" value="Individu" class="text-red-600 focus:ring-red-500">
              <span class="ml-2 text-gray-700">Individu</span>
            </label>
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="tipe_partisipasi" value="Tim" class="text-red-600 focus:ring-red-500">
              <span class="ml-2 text-gray-700">Tim</span>
            </label>
          </div>
        </div>

        <!-- 6. Nama Tim -->
    

        <!-- 7. Nomor Kontak -->
    <div>
          <label for="deskripsi" class="block text-sm font-medium text-gray-700 mb-1">Deskripsi Proyek</label>
          <textarea id="deskripsi" name="deskripsi" rows="4" placeholder="Describe your project or competition entry..." class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
        </div>


        <!-- 8. Deskripsi Proyek -->
        <div>
          <label for="deskripsi" class="block text-sm font-medium text-gray-700 mb-1">Deskripsi Proyek</label>
          <textarea id="deskripsi" name="deskripsi" rows="4" placeholder="Describe your project or competition entry..." class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
        </div>

        <!-- 9. Tombol Pendaftaran -->
        <div>
          <button type="submit" class="bg-red-700 hover:bg-red-800 text-white font-semibold py-2.5 px-6 rounded-md shadow transition duration-200">
            Daftar Sekarang
          </button>
        </div>

      </form>
    </main>

    <!-- TUGAS 3: TABEL PESERTA -->
    <section class="bg-white p-6 md:p-8 rounded-lg shadow-md">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Daftar Peserta Terdaftar</h2>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse border border-gray-200">
          <thead>
            <tr class="bg-red-800 text-white">
              <th class="py-3 px-4 border border-red-900 font-semibold text-center">Tidak</th>
              <th class="py-3 px-4 border border-red-900 font-semibold">Peserta</th>
              <th class="py-3 px-4 border border-red-900 font-semibold text-center">Kelas</th>
              <th class="py-3 px-4 border border-red-900 font-semibold">Kategori</th>
              <th class="py-3 px-4 border border-red-900 font-semibold">Tim</th>
              <th class="py-3 px-4 border border-red-900 font-semibold text-center">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <tr class="hover:bg-gray-50">
              <td class="py-3 px-4 border border-gray-200 text-center">1</td>
              <td class="py-3 px-4 border border-gray-200 font-medium">Ahmad Fauzan</td>
              <td class="py-3 px-4 border border-gray-200 text-center">X</td>
              <td class="py-3 px-4 border border-gray-200">Pengembangan Web</td>
              <td class="py-3 px-4 border border-gray-200">Kode X</td>
              <td class="py-3 px-4 border border-gray-200 text-center">
                <span class="inline-block bg-green-100 text-green-800 text-xs px-2.5 py-1 rounded-full font-semibold">Terdaftar</span>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-3 px-4 border border-gray-200 text-center">2</td>
              <td class="py-3 px-4 border border-gray-200 font-medium">Putri Aisyah</td>
              <td class="py-3 px-4 border border-gray-200 text-center">XI</td>
              <td class="py-3 px-4 border border-gray-200">Proyek IoT</td>
              <td class="py-3 px-4 border border-gray-200">Teknologi Pintar</td>
              <td class="py-3 px-4 border border-gray-200 text-center">
                <span class="inline-block bg-yellow-100 text-yellow-800 text-xs px-2.5 py-1 rounded-full font-semibold">Tertunda</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

  </div>

</body>
</html>