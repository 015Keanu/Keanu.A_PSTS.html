<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>submit tugas piket</title>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- 1. TAMBAHKAN STYLE UTK ANIMASI EMOJI DI SINI -->
    <style>
      .emoji-fly {
        position: fixed;
        bottom: -60px;
        font-size: 2.5rem;
        pointer-events: none;
        z-index: 9999;
        animation: terbangKeAtas 2s linear forwards; 
      }

      @keyframes terbangKeAtas {
        0% {
          bottom: -60px;
          opacity: 1;
          transform: translateX(0) scale(1);
        }
        100% {
          bottom: 105vh;
          opacity: 0;
          transform: translateX(var(--x-random)) rotate(360deg) scale(1.2); 
        }
      }
    </style>
</head>
<!-- Ganti class gradasi warna sebelumnya dengan inline style background-image -->
<body class="relative min-h-screen flex items-center justify-center p-4 font-sans overflow-x-hidden bg-cover bg-center">

   <video class="fixed inset-0 h-full w-full object-cover z-0" autoplay muted loop playsinline>
    <source src="ancient-remnants.3840x2160.mp4" type="video/mp4">
    Browser Anda tidak mendukung tag video.
    </video>

     <!-- 2. OVERLAY GELAP (Opsional: Agar video tidak terlalu terang dan teks card terbaca) -->
  <div class="fixed inset-0 bg-black/40 z-10 pointer-events-none"></div>


    <!-- div untuk card -->
    <div class="z-20 py-6 w-full max-w-sm bg-gradient-to-t from-green-700 to-green-950 rounded-2xl shadow-2xl overflow-hidden">

         <!-- div untuk header / ava -->
        <div>

             <!-- div untuk border profile picture -->
            <div>
            </div>
        </div>

        <div class="flex justify-center gap-3 pt-4">
        <a href="schedule.html" target="_blank" class="animate- px-5 py-2 bg-yellow-400 hover:bg-green-600 text-sm text-black font-medium rounded-md border border-indigo-900 transision-colors">Piket Schedule</a>
        
    </div>

        <!-- div for profile card section -->
        <div class="text-center text-yellow-500 space-y-2">
            <!-- div for profile information -->
            <div>
                <h2 class="text-xl font-bold tracking-wide">Classroom cleaning record</h2>
                <div class="flex items-center justify-center gap-1 text-sm text-indigo-300 mt-1">
                </div>
            </div>

            <div class="flex justify-center gap-3 pt-4">
            </div>

            <hr class="border-indigo-900/60 my-4"/>

            <!-- skills area -->
            <div class="text-left px-6">
                <!-- div for span -->
                <div class="flex flex-cols-3 gap-3 text-sm text-indigo-300">
                </div>
            </div>

            <hr class="border-indigo-900/60 my-4"/>

            <div class="text-left px-6">
                <h3 class="text-sm font-bold tracking-wider text-indigo-200 mb-2">SEND A MESSAGE</h3>
                <form action="#" method="POST" class="space-y-4">
                    <div>
                        <label for="Name">Name</label>
                        <input type="text" placeholder="Your Name" class="w-full px-3 py-2 text-sm bg-[#121235] text-white rounded border border-indigo-900/80 focus:outline-none focus:border-indigo-500 placeholder-indigo-400" required/>
                    </div>
                   <div>
                    <label for="classroom">Classroom</label>
                    <select id="classroom" name="classroom" class="w-full px-3 py-2 text-sm bg-[#121235] text-white rounded border border-indigo-900/80 focus:outline-none focus:border-indigo-500 placeholder-indigo-400" required>
                        <option value="">Select Classroom</option>
                        <option value="X-1">x-1</option>
                        <option value="X-2">x-2</option>
                        </select>
                   </div>
                    <div>
                        <label for="date">Date</label>
                        <input type="date" placeholder="Your Date" class="w-full px-3 py-2 text-sm bg-[#121235] text-white rounded border border-indigo-900/80 focus:outline-none focus:border-indigo-500 placeholder-indigo-400" required/>
                    </div>
                    <div>
                        <label for="message">Tugas yang di lakukan</label>
                        <textarea id="message" placeholder="Tugas yang sudah di lakukan" class="w-full px-3 py-2 text-sm bg-[#121235] text-white rounded border border-indigo-900/80 focus:outline-none focus:border-indigo-500 placeholder-indigo-400" required></textarea>
                    </div>
                   
                    <!-- 2. TAMBAHKAN id="submitBtn" PADA BUTTON ANDA -->
                    <button type="submit" id="submitBtn" class="animate-pulse px-3 py-2 bg-red-500 hover:bg-blue-600 text-sm text-white font-medium rounded-md border border-yellow-900 transition-colors shadow">Send Message</button>
                </form>
            </div>
        </div>        
    </div>

    <!-- 3. TAMBAHKAN LOGIKA JAVASCRIPT DI SINI (Sebelum penutup body) -->
    <script>
      const btn = document.getElementById('submitBtn');
      // Anda bisa mengganti isi emoji sapu/bersih-bersih di bawah ini sesuai tema Classroom Cleaning
      const emojis = ['🧹', '✨', '🪣', '🧼', '🥳', '❤️', '🎉'];

      btn.addEventListener('click', (e) => {
        // Cek dulu apakah form input yang wajib (required) sudah diisi atau belum
        const form = btn.closest('form');
        if (!form.checkValidity()) {
            return; // Jika belum diisi, animasi tidak jalan dan validasi bawaan browser muncul
        }

        e.preventDefault(); // Mencegah reload halaman simulasi submit

        // Munculkan 15 emoji
        for (let i = 0; i < 15; i++) {
          createEmoji();
        }
      });

      function createEmoji() {
        const emojiEl = document.createElement('span');
        emojiEl.classList.add('emoji-fly');
        
        emojiEl.innerText = emojis[Math.floor(Math.random() * emojis.length)];
        
        const randomX = Math.random() * 100;
        emojiEl.style.left = `${randomX}vw`;
        
        const randomSpread = (Math.random() - 0.5) * 300; 
        emojiEl.style.setProperty('--x-random', `${randomSpread}px`);
        
        emojiEl.style.animationDelay = `${Math.random() * 0.6}s`;

        document.body.appendChild(emojiEl);

        setTimeout(() => {
          emojiEl.remove();
        }, 2600); 
      }
    </script>
</body>
</html>

